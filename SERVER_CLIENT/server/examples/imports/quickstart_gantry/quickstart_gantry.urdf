<?xml version="1.0"?>
<!-- Fictional virtual robot. SI units. Acceleration is a RoboDE-supported URDF extension; values are illustrative simulation settings, not manufacturer ratings. -->
<robot name="Quickstart Gantry">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 .03" />
      <geometry>
        <box size=".24 .24 .06" />
      </geometry>
      <material name="base_link_color">
        <color rgba=".18 .23 .32 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 .03" />
      <geometry>
        <box size=".24 .24 .06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 .03" />
      <mass value="0.2" />
      <inertia ixx=".001" ixy="0" ixz="0" iyy=".001" iyz="0" izz=".001" />
    </inertial>
  </link>
  <link name="x_carriage">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".12 .08 .04" />
      </geometry>
      <material name="x_carriage_color">
        <color rgba=".2 .5 .95 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".12 .08 .04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx=".001" ixy="0" ixz="0" iyy=".001" iyz="0" izz=".001" />
    </inertial>
  </link>
  <link name="y_carriage">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".06 .06 .04" />
      </geometry>
      <material name="y_carriage_color">
        <color rgba=".2 .8 .6 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".06 .06 .04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx=".001" ixy="0" ixz="0" iyy=".001" iyz="0" izz=".001" />
    </inertial>
  </link>
  <link name="z_carriage">
    <visual>
      <origin xyz="0 0 .025" />
      <geometry>
        <box size=".025 .025 .04" />
      </geometry>
      <material name="z_carriage_color">
        <color rgba=".95 .65 .2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 .025" />
      <geometry>
        <box size=".025 .025 .04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 .025" />
      <mass value="0.2" />
      <inertia ixx=".001" ixy="0" ixz="0" iyy=".001" iyz="0" izz=".001" />
    </inertial>
  </link>
  <link name="tool_tip">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".025 .025 .025" />
      </geometry>
      <material name="tool_tip_color">
        <color rgba=".85 .3 .4 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".025 .025 .025" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx=".001" ixy="0" ixz="0" iyy=".001" iyz="0" izz=".001" />
    </inertial>
  </link>
  <joint name="slide_x" type="prismatic">
    <parent link="base_link" />
    <child link="x_carriage" />
    <origin xyz="0 0 .16" />
    <axis xyz="1 0 0" />
    <limit lower="-0.5" upper="0.5" effort="20" velocity=".3" acceleration=".8" />
  </joint>
  <joint name="slide_y" type="prismatic">
    <parent link="x_carriage" />
    <child link="y_carriage" />
    <origin xyz="0 0 .06" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.5" upper="0.5" effort="20" velocity=".3" acceleration=".8" />
  </joint>
  <joint name="slide_z" type="prismatic">
    <parent link="y_carriage" />
    <child link="z_carriage" />
    <origin xyz="0 0 .06" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.5" effort="20" velocity=".3" acceleration=".8" />
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="z_carriage" />
    <child link="tool_tip" />
    <origin xyz="0 0 .085" />
  </joint>
</robot>
