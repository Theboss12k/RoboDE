<?xml version="1.0"?>
<!-- Fictional "Tarnwick TR-GR40 Kestrel" gantry rover for URDF import, mapping and simulation practice.
     Not a real product and not a rated hardware model. SI units: metres, radians, kilograms.
     A differential-drive chassis carries a three-axis gantry (X rails, Y beam carriage, Z lift that extends
     downward) and a three-joint arm with a single-jaw gripper hanging from the lift.
     Configure during import: acceleration limits (suggested 0.4 m/s² for gantry axes, 2.0 rad/s² for arm joints,
     6.0 rad/s² for wheels), a control window for each continuous wheel (suggested -1000 to 1000 rad), the tool link
     (tool_tip), wheel radius 0.08 m, track width 0.46 m, footprint [[-0.32,-0.25],[0.32,-0.25],[0.32,0.25],[-0.32,0.25]]
     and navigation bounds for your scene. The matching vendor manual is gantry_rover_sdk_manual.md. -->
<robot name="Tarnwick TR-GR40 Kestrel gantry rover">

  <!-- Chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.60 0.44 0.16"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.14"/>
      <geometry><box size="0.60 0.44 0.16"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.13"/>
      <mass value="38.5"/>
      <inertia ixx="0.71" ixy="0" ixz="0" iyy="1.24" iyz="0" izz="1.78"/>
    </inertial>
  </link>

  <!-- Drive wheels (continuous; configure a control window during import) -->
  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.045"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="1.6"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0051" iyz="0" izz="0.0028"/>
    </inertial>
  </link>
  <joint name="left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.23 0.08"/>
    <axis xyz="0 1 0"/>
    <limit effort="35" velocity="12"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.045"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="1.6"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0051" iyz="0" izz="0.0028"/>
    </inertial>
  </link>
  <joint name="right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.23 0.08"/>
    <axis xyz="0 1 0"/>
    <limit effort="35" velocity="12"/>
  </joint>

  <!-- Passive casters, modelled as fixed supports -->
  <link name="front_caster">
    <visual><geometry><sphere radius="0.035"/></geometry></visual>
    <collision><geometry><sphere radius="0.035"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="front_caster_mount" type="fixed">
    <parent link="base_link"/><child link="front_caster"/>
    <origin xyz="0.25 0 0.035"/>
  </joint>
  <link name="rear_caster">
    <visual><geometry><sphere radius="0.035"/></geometry></visual>
    <collision><geometry><sphere radius="0.035"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="rear_caster_mount" type="fixed">
    <parent link="base_link"/><child link="rear_caster"/>
    <origin xyz="-0.25 0 0.035"/>
  </joint>

  <!-- Gantry frame: two posts rigidly mounted on the chassis. The beam (x_shuttle) rides on top of them.
       Each post has its own collision box, so the carriage, lift and arm between them are free to move. -->
  <link name="gantry_frame">
    <visual>
      <origin xyz="0 0.26 0.31"/>
      <geometry><box size="0.06 0.04 0.62"/></geometry>
    </visual>
    <visual>
      <origin xyz="0 -0.26 0.31"/>
      <geometry><box size="0.06 0.04 0.62"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0.26 0.31"/>
      <geometry><box size="0.06 0.04 0.62"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.26 0.31"/>
      <geometry><box size="0.06 0.04 0.62"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.35"/>
      <mass value="9.2"/>
      <inertia ixx="0.42" ixy="0" ixz="0" iyy="0.29" iyz="0" izz="0.18"/>
    </inertial>
  </link>
  <joint name="gantry_frame_mount" type="fixed">
    <parent link="base_link"/><child link="gantry_frame"/>
    <origin xyz="0 0 0.22"/>
  </joint>

  <!-- X: the beam shuttle travels fore and aft on top of the posts -->
  <link name="x_shuttle">
    <visual><geometry><box size="0.10 0.56 0.05"/></geometry></visual>
    <collision><geometry><box size="0.10 0.56 0.05"/></geometry></collision>
    <inertial><mass value="2.4"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.05"/></inertial>
  </link>
  <joint name="gantry_x" type="prismatic">
    <parent link="gantry_frame"/><child link="x_shuttle"/>
    <origin xyz="0 0 0.645"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.12" upper="0.12" effort="180" velocity="0.20"/>
  </joint>

  <!-- Y: the carriage travels across the beam -->
  <link name="y_carriage">
    <visual><geometry><box size="0.12 0.10 0.08"/></geometry></visual>
    <collision><geometry><box size="0.12 0.10 0.08"/></geometry></collision>
    <inertial><mass value="1.9"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
  </link>
  <joint name="gantry_y" type="prismatic">
    <parent link="x_shuttle"/><child link="y_carriage"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.18" upper="0.18" effort="150" velocity="0.25"/>
  </joint>

  <!-- Z: the lift extends downward, so its axis points down and positive travel lowers the arm -->
  <link name="z_lift">
    <visual>
      <origin xyz="0 0 -0.12"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.12"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
    <inertial><origin xyz="0 0 -0.12"/><mass value="1.4"/><inertia ixx="0.007" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.0006"/></inertial>
  </link>
  <joint name="gantry_z" type="prismatic">
    <parent link="y_carriage"/><child link="z_lift"/>
    <origin xyz="0 0 -0.04"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.32" effort="220" velocity="0.15"/>
  </joint>

  <!-- Arm: shoulder yaw, elbow pitch, wrist pitch -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0.125 0 0"/>
      <geometry><box size="0.25 0.05 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.125 0 0"/>
      <geometry><box size="0.25 0.05 0.05"/></geometry>
    </collision>
    <inertial><origin xyz="0.125 0 0"/><mass value="1.1"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/></inertial>
  </link>
  <joint name="shoulder_yaw" type="revolute">
    <parent link="z_lift"/><child link="shoulder_link"/>
    <origin xyz="0 0 -0.24"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="24" velocity="1.4"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0.11 0 0"/>
      <geometry><box size="0.22 0.045 0.045"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.11 0 0"/>
      <geometry><box size="0.22 0.045 0.045"/></geometry>
    </collision>
    <inertial><origin xyz="0.11 0 0"/><mass value="0.8"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0033" iyz="0" izz="0.0033"/></inertial>
  </link>
  <joint name="elbow_pitch" type="revolute">
    <parent link="shoulder_link"/><child link="forearm_link"/>
    <origin xyz="0.25 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="14" velocity="1.6"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.04 0 0"/>
      <geometry><box size="0.08 0.04 0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.04 0 0"/>
      <geometry><box size="0.08 0.04 0.04"/></geometry>
    </collision>
    <inertial><origin xyz="0.04 0 0"/><mass value="0.35"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm_link"/><child link="wrist_link"/>
    <origin xyz="0.22 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="6" velocity="2.0"/>
  </joint>

  <!-- Single-jaw gripper: one moving jaw against a fixed jaw; positive travel opens -->
  <link name="gripper_jaw_link">
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.012 0.03"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.012 0.03"/></geometry>
    </collision>
    <inertial><mass value="0.08"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
  </link>
  <joint name="gripper_jaw" type="prismatic">
    <parent link="wrist_link"/><child link="gripper_jaw_link"/>
    <origin xyz="0.08 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.045" effort="40" velocity="0.05"/>
  </joint>

  <link name="tool_tip"/>
  <joint name="tool_mount" type="fixed">
    <parent link="wrist_link"/><child link="tool_tip"/>
    <origin xyz="0.14 0 0"/>
  </joint>
</robot>
