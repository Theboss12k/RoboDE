<?xml version="1.0"?>
<!-- Fictional simulation fixture; not a rated hardware model. Configure wheel radius 0.05 m, track width 0.30 m and reviewed acceleration limits during import. -->
<robot name="Fictional mobile manipulator">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 .12" />
      <geometry>
        <box size=".3 .24 .12" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 .12" />
      <geometry>
        <box size=".3 .24 .12" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 .12" />
      <mass value="5" />
      <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01" />
    </inertial>
  </link>
  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".05" length=".025" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".05" length=".025" />
      </geometry>
    </collision>
    <inertial>
      <mass value=".2" />
      <inertia ixx=".001" ixy="0" ixz="0" iyy=".001" iyz="0" izz=".001" />
    </inertial>
  </link>
  <joint name="left_wheel" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0 0.15 .05" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="10" />
  </joint>
  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".05" length=".025" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".05" length=".025" />
      </geometry>
    </collision>
    <inertial>
      <mass value=".2" />
      <inertia ixx=".001" ixy="0" ixz="0" iyy=".001" iyz="0" izz=".001" />
    </inertial>
  </link>
  <joint name="right_wheel" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0 -0.15 .05" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="10" />
  </joint>
  <link name="rear_support">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".035 .035 .035" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".035 .035 .035" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01" />
    </inertial>
  </link>
  <joint name="support_mount" type="fixed">
    <parent link="base_link" />
    <child link="rear_support" />
    <origin xyz="-.12 0 .0175" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="yaw_link">
    <visual>
      <origin xyz="0 0 .04" />
      <geometry>
        <box size=".06 .06 .08" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 .04" />
      <geometry>
        <box size=".06 .06 .08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 .04" />
      <mass value="0.2" />
      <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01" />
    </inertial>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz=".12 0 0" />
      <geometry>
        <box size=".24 .035 .035" />
      </geometry>
    </visual>
    <collision>
      <origin xyz=".12 0 0" />
      <geometry>
        <box size=".24 .035 .035" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz=".12 0 0" />
      <mass value="0.2" />
      <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01" />
    </inertial>
  </link>
  <link name="forearm">
    <visual>
      <origin xyz=".1 0 0" />
      <geometry>
        <box size=".2 .03 .03" />
      </geometry>
    </visual>
    <collision>
      <origin xyz=".1 0 0" />
      <geometry>
        <box size=".2 .03 .03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz=".1 0 0" />
      <mass value="0.2" />
      <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01" />
    </inertial>
  </link>
  <link name="tool_tip">
    <visual>
      <origin xyz=".03 0 0" />
      <geometry>
        <box size=".06 .035 .035" />
      </geometry>
    </visual>
    <collision>
      <origin xyz=".03 0 0" />
      <geometry>
        <box size=".06 .035 .035" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz=".03 0 0" />
      <mass value="0.2" />
      <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01" />
    </inertial>
  </link>
  <link name="finger">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".02 .015 .04" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size=".02 .015 .04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01" />
    </inertial>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link" />
    <child link="yaw_link" />
    <origin xyz="0 0 .19" />
    <axis xyz="0 0 1" />
    <limit effort="20" velocity="1" lower="-3.14" upper="3.14" />
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="yaw_link" />
    <child link="upper_arm" />
    <origin xyz="0 0 .09" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="1" lower="-2.0" upper="2.0" />
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz=".26 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="1" lower="-2.6" upper="2.6" />
  </joint>
  <joint name="wrist" type="revolute">
    <parent link="forearm" />
    <child link="tool_tip" />
    <origin xyz=".22 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="1" lower="-3.14" upper="3.14" />
  </joint>
  <joint name="gripper" type="prismatic">
    <parent link="tool_tip" />
    <child link="finger" />
    <origin xyz=".06 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="0.1" lower="0.0" upper="0.08" />
  </joint>
</robot>
