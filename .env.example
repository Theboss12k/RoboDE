# Optional compatible chat-completions provider; leave blank to use local templates.
# Select an actual supported model and endpoint from your provider's documentation.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# GPU worker reachable through loopback/SSH tunnel; match the worker's secret token.
ISAAC_WORKER_URL=http://127.0.0.1:9100
ISAAC_WORKER_TOKEN=

# Optional live manual ROS 2 bridge. Keep the secret out of adapter metadata.
# Profiles refer to this environment variable by name.
ROS_BRIDGE_TOKEN=

# Separate NuRec reconstruction worker. Capture/upload works without GPU service.
NUREC_WORKER_URL=http://127.0.0.1:9200
NUREC_WORKER_TOKEN=
# On the GPU VM ONLY: both workers write work heartbeats for the guest watchdog.
# ROBOT_IDE_ACTIVITY_DIR=/var/lib/robot-ide/activity
# ROBOT_IDE_ALLOW_ROOM_UPLOADS=1
# THREEDGRUT_ROOT=/opt/3dgrut
# NUREC_JOBS_ROOT=/data/nurec-jobs

# Optional phone HTTPS gateway. npm run business:phone generates/stores a private code.
# BUSINESS_ACCESS_CODE=
